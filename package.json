{
  "name": "opencode-side-chat",
  "version": "0.0.1",
  "description": "OpenCode Desktop side chats: ask follow-up questions in a side panel that branches from the current chat, and keep every side chat linked to it.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "side-chat",
    "btw",
    "fork"
  ],
  "type": "module",
  "license": "MIT",
  "author": "parzival1l",
  "homepage": "https://github.com/parzival1l/opencode-side-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parzival1l/opencode-side-chat.git"
  },
  "bugs": "https://github.com/parzival1l/opencode-side-chat/issues",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
